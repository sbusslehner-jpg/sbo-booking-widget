//
// Authentication via Bearer-Token oder Session-Cookie (vom Konsumenten gesetzt).

import type { BookingDraft } from '../../types'
import type { StorageAdapter } from './StorageAdapter'

export type BackendStorageAdapterOptions = {
  baseUrl: string
  dealerId: string
