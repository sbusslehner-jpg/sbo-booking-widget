{
  "name": "@dealer/booking-widget",
  "version": "1.3.0",
  "description": "Werkstatt-Booking-Widget für Autohaus Senker — dreistufiges Buchungs-Widget mit Web-Component-Embedding.",
  "private": false,
  "type": "module",
  "main": "./dist/booking-widget.umd.js",
  "module": "./dist/booking-widget.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/booking-widget.es.js",
      "require": "./dist/booking-widget.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:lib": "tsc -p tsconfig.build.json && BUILD_TARGET=lib vite build",
    "build:demo": "BUILD_TARGET=demo vite build",
    "build:netlify": "npm run build:lib && npm run build:demo && cp dist/booking-widget.umd.js dist/booking-widget.es.js dist/index.d.ts dist-demo/ && node scripts/post-build.mjs",
    "preview": "vite preview --outDir dist-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^23.11.5",
    "lucide-react": "^0.408.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7.52.1",
    "react-i18next": "^14.1.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
