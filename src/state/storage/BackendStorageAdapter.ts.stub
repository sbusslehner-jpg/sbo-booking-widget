    throw new Error('BackendStorageAdapter ist noch nicht implementiert.')
  }

  async load(): Promise<BookingDraft | null> {
    // TODO: fetch(`${baseUrl}/booking-drafts/${this.draftId}`)
    throw new Error('BackendStorageAdapter ist noch nicht implementiert.')
